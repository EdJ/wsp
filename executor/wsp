#!/bin/sh
# wsp, on a machine that has no wsp.
#
# An executor holds no store, no state directory and no wsp binary — the seat is
# the one source of truth, which is what makes there be no sync, no merge story
# and nothing here to hot-patch. So `wsp` here runs the seat's `wsp`, over the
# ssh connection the seat is already holding open.
#
# Install: on PATH ahead of anything else called wsp, with WSP_SEAT set for
# every shell an agent might run in. See the Machines section of wsp's README.
#
#   WSP_SEAT      the seat's ssh Host alias, as this machine reaches it
#   WSP_SEAT_ID   which seat this is (cpd-N). wsp mints it and puts it in the
#                 environment of the session it starts here; passed through
#   WSP_SEAT_BIN  the seat's wsp, if it is not on a non-interactive PATH there
#
# Four things this has to get right, and each of them is silent when wrong:
#
#   1. Arguments survive the remote shell. `ssh host wsp say "two words"` is
#      re-split over there; every argument is quoted for it here.
#   2. The seat is named by WSP_SEAT_ID, which is the seat's own id and needs
#      no qualifying: wsp mints it and the machine rides on the seat's record,
#      so no `@machine` is added to anything.
#   3. The exit status is the seat's, with one exception that is the point of it:
#      ssh itself failing (it exits 255 when it cannot connect; a wsp verb never
#      does) is exit 75, EX_TEMPFAIL, with `wsp: the seat is unreachable (link
#      down since <time>)`. A verb that ran and failed keeps its own status, so an
#      agent, a hook and a person can each tell a refusal from a partition. The
#      hand proof of 2026-11-05 saw a call made in the gap before the gate held
#      come back exit 0 behind a pipe; nothing but this status says it did not run.
#      The time is the first failure since the last success, kept in
#      $WSP_LINK_FILE (default $WSP_EXEC_DIR/link-down, else ~/.wsp-executor/).
#   4. Tree verbs (docs/remote-agents.md section 5). `verify`, `review` and
#      `commit-help` are run with WSP_EXECUTOR_TREE=1, which makes the seat copy
#      the agent's work back first (refusing on a stale conflict) and run on the
#      seat's tree. `checkpoint` is the far tree's `Stop` hook (spawn writes it):
#      the seat copies back the files that changed, and nothing else runs.
#      `checkout` and `land` are refused here, with a sentence and
#      without asking the seat: the row's worktree was made by the seat, and a
#      verifier lands it.
#
# stdin reaches the far side, which `wsp edit --overview -` needs and agents
# use constantly. There is no tty, so `wsp edit` without `--from` will not find
# an editor — which is right: nobody is sitting here.

set -e

if [ -z "${WSP_SEAT:-}" ]; then
    echo "wsp: WSP_SEAT is not set — this machine is an executor and has no wsp of its own." >&2
    echo "     See the Machines section of wsp's README." >&2
    exit 2
fi

case "${1:-}" in
    checkout | land)
        echo "wsp: \`wsp $1\` is not run from an executor — the seat made this row's worktree and a verifier lands it; finish with \`wsp review\`." >&2
        exit 2
        ;;
esac

# One argument, quoted so the remote shell hands it back whole.
q() {
    printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

args=''
for a in "$@"; do
    args="$args $(q "$a")"
done

# Only what wsp reads. ssh forwards no environment by default and should not:
# a seat-shaped PATH or HOME arriving from here would be worse than none.
env="WSP_SEAT_ID=$(q "${WSP_SEAT_ID:-}")"
env="$env WSP_PROJECT=$(q "${WSP_PROJECT:-}") WSP_TASK=$(q "${WSP_TASK:-}")"
env="$env WSP_TERSE=$(q "${WSP_TERSE:-}") WSP_EXECUTOR=1"
case "${1:-}" in
    verify | review | commit-help | checkpoint) env="$env WSP_EXECUTOR_TREE=1" ;;
esac

# Not `exec`: the status is read here. Anything but 255 is the seat's own.
link_file="${WSP_LINK_FILE:-${WSP_EXEC_DIR:-$HOME/.wsp-executor}/link-down}"
rc=0
ssh -o BatchMode=yes "$WSP_SEAT" "$env ${WSP_SEAT_BIN:-wsp}$args" || rc=$?

if [ "$rc" -eq 255 ]; then
    if [ ! -s "$link_file" ]; then
        mkdir -p "$(dirname "$link_file")" 2>/dev/null || true
        date '+%H:%M:%S' >"$link_file" 2>/dev/null || true
    fi
    echo "wsp: the seat is unreachable (link down since $(cat "$link_file" 2>/dev/null || date '+%H:%M:%S'))" >&2
    exit 75
fi
rm -f "$link_file" 2>/dev/null || true
exit "$rc"
